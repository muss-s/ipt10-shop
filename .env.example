APP_NAME="KAGE 影 SUPPLY"
APP_URL=http://localhost:8000
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila

# sqlite (default) or mysql
DB_DRIVER=sqlite
DB_DATABASE=storage/database/shop.sqlite
# Used only when DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

CURRENCY_API_URL=https://api.frankfurter.dev/v1
CURRENCY_CACHE_TTL=3600

# Seeded local test accounts (created by bin/migrate.php --seed)
SEED_ADMIN_EMAIL=admin@shop.test
SEED_ADMIN_PASSWORD=admin123
SEED_CUSTOMER_EMAIL=juan@shop.test
SEED_CUSTOMER_PASSWORD=customer123
